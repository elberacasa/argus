{
  "manifest_version": 3,
  "name": "Argus",
  "version": "0.2.3",
  "description": "Lets argus drive tabs it opens in this browser, with your logins. It never touches tabs it did not open.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "worker-0.2.3.js"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "storage"
  ]
}
