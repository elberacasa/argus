#!/bin/bash

# argus-mcp -- Argus for any MCP client (Claude Code, opencode, Codex, ...).
#
# Starts argusd's MCP server on stdio. The server starts the daemon itself if
# it is not already running. Uses the compiled argusd when it is current, and
# the source otherwise, so a stale build never answers.

set -euo pipefail
ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
BIN=$ROOT/argusd/dist/argusd

if [[ -x $BIN && -z $(find "$ROOT/argusd/src" -newer "$BIN" -name '*.ts' -print -quit) ]]; then
  exec "$BIN" mcp
fi
command -v bun >/dev/null || { echo "argus-mcp: needs bun (https://bun.sh) or a build: cd argusd && bun run build" >&2; exit 1; }
[[ -d $ROOT/argusd/node_modules ]] || (cd "$ROOT/argusd" && bun install --silent >&2)
exec bun "$ROOT/argusd/src/main.ts" mcp
