#!/bin/bash

# argus -- drive browsers and be told the truth about what happened.
#
# Browser commands go to argusd, the daemon (started on first use), which
# verifies every step and names every failure. Features argusd does not serve
# yet -- desks, your own browser, nests, the bar, visual deltas and marks --
# are handled by argus-legacy, the bash implementation, until they move over.

set -uo pipefail
ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)

legacy=false
for a in "$@"; do
  case $a in
    --desk|--own|--see|--no-trace) legacy=true ;;
  esac
done
# The first word that is not an option (or an option's value) is the command.
cmd="" skip=false
for a in "$@"; do
  if [[ $skip == true ]]; then skip=false; continue; fi
  case $a in
    --lane|--expect) skip=true ;;
    -*) ;;
    *) cmd=$a; break ;;
  esac
done
case $cmd in
  desk|peek|own|bar|nest|watch|pool|marks|delta|text|shutdown) legacy=true ;;
esac
[[ $legacy == true ]] && exec "$ROOT/bin/argus-legacy" "$@"

BIN=$ROOT/argusd/dist/argusd
if [[ -x $BIN && -z $(find "$ROOT/argusd/src" -newer "$BIN" -name '*.ts' -print -quit) ]]; then
  exec "$BIN" cli "$@"
fi
command -v bun >/dev/null || { echo "argus: needs bun (https://bun.sh) or a build: cd argusd && bun run build" >&2; exit 1; }
[[ -d $ROOT/argusd/node_modules ]] || (cd "$ROOT/argusd" && bun install --silent >&2)
exec bun "$ROOT/argusd/src/main.ts" cli "$@"
